local_names = {
    "alice",
    "bob",
    "charlie",
    "diana",
    "eve",
    "frank",
    "grace"
}

function random_name()
    local f = io.open("/dev/urandom", "rb")
    if not f then
        return "unknown"
    end

    local bytes = f:read(4)
    f:close()

    local n = 0
    for i = 1, #bytes do
        n = n * 256 + string.byte(bytes, i)
    end

    return local_names[(n % #local_names) + 1]
end

auth:add_incomming_hook("example.com", function(client, req, context)
    local name = random_name()
    resp = auth:resp_update_ctx()
    resp:add_to_ctx("user", name)
    return resp
end)
